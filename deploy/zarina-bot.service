[Unit]
Description=ZarinaAssistent Telegram birthday bot
After=network-online.target
Wants=network-online.target

[Service]
User=jahongir
WorkingDirectory=/home/jahongir/zarina-bot
ExecStart=/home/jahongir/zarina-bot/.venv/bin/python -m bot
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
